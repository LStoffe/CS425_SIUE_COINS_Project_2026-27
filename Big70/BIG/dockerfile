# ---------- Node stage: build Tailwind CSS ----------
  FROM node:20-alpine AS nodebuild
  WORKDIR /app
  
  COPY package.json package-lock.json tailwind.config.js ./
  RUN npm ci
  
  COPY src ./src
  RUN npm run build:css
  
  
  # ---------- Maven stage: build Spring Boot jar ----------
  FROM maven:3.9-eclipse-temurin-21 AS build
  WORKDIR /app
  
  COPY pom.xml ./
  COPY src ./src
  COPY libs ./libs
  
  # Bring in the generated Tailwind output from the node stage
  COPY --from=nodebuild /app/src/main/resources/static/css/tailwind.css \
    ./src/main/resources/static/css/tailwind.css
  
  # IMPORTANT: skip the Maven exec plugin that tries to run npm
  RUN mvn -DskipTests -Dtailwind.skip=true clean package
  
  
  # ---------- Runtime stage ----------
  FROM eclipse-temurin:21-jre
  WORKDIR /app
  
  COPY --from=build /app/target/*.jar app.jar
  
  EXPOSE 8080
  ENTRYPOINT ["java", "-jar", "app.jar"]